**/.venv/
**/.venv-win/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
*.py[cod]

# Build output, browser-test artifacts, and logs
frontend/dist/
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo
*.log
