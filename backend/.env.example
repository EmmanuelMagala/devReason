
# Copy this file to .env and replace every placeholder with your real values.
# Keep live smoke test variables in .env.live_smoke instead of mixing them into .env.

# Supabase / Postgres
DATABASE_URL=postgresql+asyncpg://postgres:<db-password>@<supabase-host>:6543/postgres

# Dedicated local Redis; production may use a valid rediss:// endpoint
REDIS_URL=redis://127.0.0.1:6381/0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GitHub App (configure secrets directly in .env)
GITHUB_APP_ID=0
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_CLIENT_ID=Iv1.your-client-id
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=github_app_private_key.pem
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
FRONTEND_BASE_URL=http://localhost:5173
DURABLE_REVIEWS_ENABLED=true
BRANCH_REVIEWS_ENABLED=false
REVIEW_MAX_FILES=50
REVIEW_MAX_CHARACTERS=100000
REVIEW_CHUNK_CHARACTERS=12000
WORKER_LEASE_SECONDS=90
REVIEW_JOB_TIMEOUT_SECONDS=900

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Encryption: generate 32 random bytes with python -c "import secrets; print(secrets.token_hex(32))"
# Keep the same key after connections have been saved. Earlier 16-byte keys are supported.
ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# LangSmith
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=devReason

# NVD
NVD_API_KEY=
