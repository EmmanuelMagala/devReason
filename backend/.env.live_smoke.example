# Copy this file to .env.live_smoke and fill in the values before running
# scripts/run_live_smoke.sh or scripts/run_backend_and_live_smoke.sh.
#
# Quick checks:
#   ./scripts/live_smoke_status.sh
#   ./scripts/validate_live_smoke_env.sh

# Base URL for the already-running backend under test.
LIVE_SMOKE_BASE_URL=http://127.0.0.1:8000

# Clerk session token and matching user details.
# Get the token from a real signed-in Clerk session.
# If Clerk is available in the browser console, try:
#   await Clerk.session.getToken()
LIVE_SMOKE_CLERK_BEARER_TOKEN=

# Clerk user ID for the same account as the bearer token.
# Expected shape: user_...
LIVE_SMOKE_CLERK_USER_ID=

# Email for the same Clerk account.
LIVE_SMOKE_CLERK_EMAIL=

# Clerk webhook signing secret for the webhook that targets POST /webhooks/clerk.
# Expected shape: whsec_...
LIVE_SMOKE_CLERK_WEBHOOK_SECRET=

# GitHub repo + PR used for repo/rules/chat/review smoke tests.
# Owner and repo should match the PR URL below.
LIVE_SMOKE_GITHUB_OWNER=
LIVE_SMOKE_GITHUB_REPO=

# GitHub PAT with repo read access, and comment/review write access if you later
# want to test post_to_github=true.
LIVE_SMOKE_GITHUB_PAT=

# Real pull request URL in the same repository.
# Expected shape: https://github.com/<owner>/<repo>/pull/<number>
LIVE_SMOKE_GITHUB_PR_URL=

# Optional overrides for test payloads.
LIVE_SMOKE_CHAT_MESSAGE=Summarize the most common findings for this repository.
LIVE_SMOKE_RULE_CONTENT=Background jobs must not perform blocking I/O in route handlers.
